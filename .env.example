# Hugging Face token for loading Gemma and other gated models
HUGGINGFACE_TOKEN=your_huggingface_token_here

# OpenAI API key used by the LangChain agent in the Streamlit app
OPENAI_API_KEY=your_openai_api_key_here

# Google Maps API key used by the clinic finder tool
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional overrides (defaults are set in config/config.py)
# LLM_MODEL_ID=google/gemma-2-9b-it
# EMBEDDING_MODEL_ID=BAAI/bge-base-en-v1.5
# WHISPER_MODEL_SIZE=base
# RAG_TOP_K=5
# MAX_NEW_TOKENS=512
# TEMPERATURE=0.7